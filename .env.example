# Скопируйте в .env и заполните. .env не коммитьте: там ключи.

# Адрес API вашей системы. Сервер проверяет токен сотрудника запросом GET {SYSTEM_URL}/me.
SYSTEM_URL=http://host.docker.internal:8000/api

# Способ входа — как в консоли платформы: user_token | service_token | none.
AUTH_MODE=user_token
# Служебный ключ платформы. Для service_token обязателен; для user_token — по желанию
# (с ним платформа заранее видит список инструментов). Сгенерировать: openssl rand -hex 32
SERVICE_TOKEN=
# Ключ сервера к API системы — только для service_token и none (в user_token игнорируется).
SYSTEM_TOKEN=

# ADDR=:8080
# METRICS_ADDR=:9090      # пусто — без /metrics
# MCP_PATH=/mcp
# LOG_LEVEL=info
# SYSTEM_TIMEOUT=15s
# SHUTDOWN_TIMEOUT=20s
